{
  "name": "marvel-universe",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para el proyecto Marvel Universe (Backend, Web y Móvil)",
  "workspaces": [
    "mobile",
    "web"
  ],
  "scripts": {
