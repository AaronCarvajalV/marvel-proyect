# ------------------------------------
# AUTENTICACIÓN
# ------------------------------------

### Registrar un Usuario ADMIN 
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "nombre": "Admin Hero",
    "email": "admin@marvel.com",
    "password": "password123",
    "password_confirmation": "password123",
    "rol": "ADMIN"
}

### Registrar un Usuario CONSULTA
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "nombre": "Usuario Consulta",
    "email": "consulta@marvel.com",
    "password": "password123",
    "password_confirmation": "password123",
    "rol": "CONSULTA"
}

### Iniciar Sesión ADMIN (Login)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@marvel.com",
    "password": "password123"
}

### Iniciar Sesión CONSULTA (Login)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "consulta@marvel.com",
    "password": "password123"
}

### Obtener Usuario Autenticado
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Cerrar Sesión (Logout)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

# ------------------------------------
# SUPERHÉROES
# ------------------------------------

### Listar todos los Superhéroes (ADMIN y CONSULTA)
GET {{baseUrl}}/heroes
Authorization: Bearer {{token}}

### Buscar Superhéroe por Nombre (ADMIN y CONSULTA)
GET {{baseUrl}}/heroes?search=Spider
Authorization: Bearer {{token}}

### Obtener un Superhéroe por ID (ADMIN y CONSULTA)
GET {{baseUrl}}/heroes/1 
Authorization: Bearer {{token}}

### Crear un Superhéroe (ADMIN)
POST {{baseUrl}}/heroes
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Spider-Man dark",
    "nombre_real": "Peter Parker",
    "poder_principal": "Sentido arácnido y fuerza proporcional de araña",
    "nivel_poder": 85,
    "imagen_url": "https://example.com/spiderman.jpg",
    "estado": "ACTIVO"
}

### Actualizar un Superhéroe (ADMIN)
PUT {{baseUrl}}/heroes/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Spider-Man dark",
    "nombre_real": "Peter Parker",
    "poder_principal": "Sentido arácnido, fuerza y traje simbiótico",
    "nivel_poder": 95,
    "imagen_url": "https://example.com/spiderman-black.jpg",
    "estado": "ACTIVO"
}

### Eliminar un Superhéroe (ADMIN)
DELETE {{baseUrl}}/heroes/1
Authorization: Bearer {{token}}

# ------------------------------------
# MISIONES
# ------------------------------------

### Listar todas las Misiones (ADMIN y CONSULTA)
GET {{baseUrl}}/misiones
Authorization: Bearer {{token}}

### Obtener una Misión por ID (ADMIN y CONSULTA)
GET {{baseUrl}}/misiones/1
Authorization: Bearer {{token}}

### Crear una Misión (ADMIN)
POST {{baseUrl}}/misiones
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "titulo": "Salvar Nueva York",
    "descripcion": "Detener el ataque del Duende Verde en el puente de Brooklyn.",
    "ubicacion": "Nueva York",
    "fecha": "2026-10-15",
    "nivel_peligro": "ALTO",
    "estado": "PENDIENTE",
    "superheroe_id": 1
}

### Actualizar datos de una Misión (ADMIN)
PUT {{baseUrl}}/misiones/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "titulo": "Salvar Nueva York",
    "descripcion": "El Duende Verde ha sido avistado. ¡Misión urgente!",
    "ubicacion": "Nueva York",
    "fecha": "2026-10-15",
    "nivel_peligro": "ALTO",
    "estado": "EN_PROGRESO",
    "superheroe_id": 1
}

### Eliminar una Misión (ADMIN)
DELETE {{baseUrl}}/misiones/1
Authorization: Bearer {{token}}
